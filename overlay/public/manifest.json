{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "TFT Enhancer",
    "author": "Stijn",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.170.0",
    "description": "Tracks how many copies of each champion are out of the TFT pool.",
    "dock_button_title": "TFT Enhancer",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon_gray.png",
    "launcher_icon": "icons/launcher_icon.ico",
    "window_icon": "icons/window_icon.png"
  },
  "permissions": ["GameInfo", "Hotkeys"],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21570]
    },
    "game_events": [21570],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [21570] },
        "start_minimized": true
      }
    ],
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "in_game": {
        "file": "in_game.html",
        "in_game_only": true,
        "transparent": true,
        "resizable": true,
        "clickthrough": false,
        "grab_keyboard_focus": false,
        "focus_game_takeover": "ReleaseOnHidden",
        "show_in_taskbar": false,
        "size": { "width": 420, "height": 640 },
        "min_size": { "width": 300, "height": 200 },
        "start_position": { "top": 80, "left": 20 }
      }
    },
    "hotkeys": {
      "toggle_overlay": {
        "title": "Show/hide pool tracker",
        "action-type": "custom",
        "default": "Ctrl+Shift+P"
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
